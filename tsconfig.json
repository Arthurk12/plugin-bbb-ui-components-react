{
    "compilerOptions": {
        "outDir": "./dist-tsc/",
        "rootDir": "./src",
        "noImplicitAny": true,
        "module": "es6",
        "target": "es2018",
        "skipLibCheck": true,
        "jsx": "react",
        "allowJs": true,
        "moduleResolution": "bundler",
        "allowSyntheticDefaultImports": true
    },
    "include": ["src/**/*"],
    "exclude": [
        "node_modules"
    ]
}
